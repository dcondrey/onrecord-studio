{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "app"
    ],
    "category": "Productivity",
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.direct.plist",
      "infoPlist": "./Info.direct.plist",
      "files": {
        "embedded.provisionprofile": "./Direct.provisionprofile"
      }
    }
  },
  "app": {
    "security": {
      "capabilities": [
        "main-window-capability",
        "direct-updater-capability"
      ]
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgzMDg1RkFENDQxMEFGMDEKUldRQnJ4QkVyVjhJZzEvTTFPeWNJbHl1L3kvNXlPRDdTUGxrTmNqMjVFTDFYdVNURnNLcmcybUMK",
      "endpoints": [
        "https://updates.writerslogic.com/onrecord/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
