{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window-capability",
  "description": "Explicit security scopes allowing front-to-back IPC interaction loops.",
  "windows": ["main"],
  "permissions": [
    "core:path:default",
    "core:app:allow-set-app-theme",
    "core:event:default",
    "core:window:default",
    "core:webview:default",
    "dialog:allow-open"
  ]
}
