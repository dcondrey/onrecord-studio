{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OnRecord Studio",
  "mainBinaryName": "OnRecord Studio",
  "version": "1.0.0-beta.1",
  "identifier": "com.onrecord.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "title": "OnRecord Studio",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Visible",
        "hiddenTitle": false,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "capabilities": ["main-window-capability"],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "publisher": "WritersLogic",
    "copyright": "Copyright © 2026 WritersLogic",
    "homepage": "https://writerslogic.com",
    "shortDescription": "Public-records investigation workspace",
    "longDescription": "Analyze public-records requests and documents locally, track statutory deadlines, and export verifiable reports.",
    "targets": "all",
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "13.0",
      "signingIdentity": null,
      "entitlements": null
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
