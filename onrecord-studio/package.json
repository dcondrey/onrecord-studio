{
  "name": "onrecord-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:ipc": "node scripts/check-ipc-contract.mjs",
    "check:help": "node scripts/check-help-coverage.mjs",
    "build:methods": "node scripts/build-methods.mjs",
    "check:methods": "node scripts/build-methods.mjs --check",
    "capture:help-screenshots": "node scripts/capture-help-screenshots.mjs",
    "check:app-store-config": "node scripts/prepare-app-store.mjs --check",
    "check:direct-config": "node scripts/prepare-direct.mjs --check && node scripts/notarize-direct.mjs --check",
    "generate:contracts": "node scripts/generate-contracts.mjs",
    "build": "npm run check:ipc && npm run check:help && tsc && vite build",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest run",
    "test:budget-comparison": "node scripts/verify-budget-comparison.mjs",
    "test:release-performance": "node scripts/validate-release-performance.mjs",
    "prepare:app-store": "node scripts/prepare-app-store.mjs",
    "build:app-store": "npm run prepare:app-store && ONRECORD_DISTRIBUTION=app-store tauri build --ci --bundles app --target aarch64-apple-darwin --features app-store --config src-tauri/tauri.appstore.conf.json",
    "notarize:direct": "node scripts/notarize-direct.mjs",
    "prepare:direct": "node scripts/prepare-direct.mjs",
    "build:direct": "node scripts/build-direct.mjs",
    "validate:app-store-bundle": "node scripts/package-app-store.mjs --validate-only",
    "package:app-store": "node scripts/package-app-store.mjs",
    "test": "npm run check:ipc && tsc --noEmit && cargo test --workspace --manifest-path src-tauri/Cargo.toml && vitest run",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "clsx": "^2.1.1",
    "pdfjs-dist": "6.3.289",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.3.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
